# ==============================================================================
# SRE AI AGENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Selection
# Options: "ollama" | "vllm" | "openrouter" | "openai" | "groq" | "mock"
# Default: "mock" (for instant zero-dependency testing) or "openrouter"
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# 2. Local Ollama Settings (when LLM_PROVIDER=ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Recommended ultra-lightweight models for CPU/8GB RAM:
# - llama3.2:1b (1.3 GB)
# - qwen2.5:1.5b (1.6 GB)
# - qwen2.5-coder:1.5b (1.6 GB)
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ------------------------------------------------------------------------------
# 3. vLLM Settings (when LLM_PROVIDER=vllm)
# ------------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# ------------------------------------------------------------------------------
# 4. OpenRouter Settings (when LLM_PROVIDER=openrouter)
# https://openrouter.ai/ - access to 500+ models with unified API
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Popular OpenRouter models supporting function calling / tool use:
# - meta-llama/llama-3.3-70b-instruct
# - qwen/qwen-2.5-coder-32b-instruct
# - deepseek/deepseek-chat
# - anthropic/claude-3.5-haiku
# - google/gemini-2.0-flash-001
OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 5. Direct OpenAI / Groq Settings (when LLM_PROVIDER=openai or groq)
# ------------------------------------------------------------------------------
# For Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1, OPENAI_MODEL=llama-3.3-70b-versatile
# For OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1, OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Security & Sandbox Guardrails
# ------------------------------------------------------------------------------
SECURITY_ENABLED=true
COMMAND_TIMEOUT_SECONDS=15
MAX_COMMAND_OUTPUT_BYTES=1048576  # 1 MB
ALLOW_NETWORK_TOOLS=true

# ------------------------------------------------------------------------------
# 6. RAG (Retrieval-Augmented Generation) Settings
# ------------------------------------------------------------------------------
DOCS_DIR=docs
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.35

# ------------------------------------------------------------------------------
# 7. Agent & Observability
# ------------------------------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_VERBOSE=true
AUDIT_LOG_FILE=logs/audit.jsonl

# ------------------------------------------------------------------------------
# 8. Web API Server
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
